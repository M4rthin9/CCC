# Copy to .dev.vars (git-ignored) for local `wrangler dev`.
# Production values go in Cloudflare secrets via `wrangler secret put <NAME>`.

TURNSTILE_SECRET=0x0000000000000000000000000000000000000000
# Comma-separated hostnames allowed for Turnstile tokens (override var)
# TURNSTILE_HOSTNAMES=cida.dpdns.org,localhost

# First-run seed users: JSON array of [username, password, role, displayName]
# Seeds get must_change_password=1 and are flagged as defaults.
SEED_USERS_JSON=[["admin","changeme123","Superadmin","ผู้ดูแลระบบ"]]

# Set to "true" to disable first-run user seeding
DISABLE_SEED_USERS=false

# Token used to protect the GAS export endpoint (scripts/migrate.mjs)
ADMIN_EXPORT_TOKEN=replace-me

# "production" enables Secure cookies; anything else is dev
# ENVIRONMENT=production
