{
  "name": "ccc-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Prison Visitor Reservation System backend — Cloudflare Workers + D1 + KV",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "migrate": "wrangler d1 migrations apply ccc-reservations --remote",
    "migrate:local": "wrangler d1 migrations apply ccc-reservations --local",
    "db:seed": "tsx scripts/migrate-sheets.ts",
    "db:import": "tsx scripts/import-sheet-delta.ts",
    "db:execute": "wrangler d1 execute ccc-reservations --remote --file=./data/seed.sql",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/verify-smoke.ts",
    "lint": "eslint src scripts",
    "lint:fix": "eslint src scripts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"scripts/**/*.ts\" \"*.{json,mjs}\" \"**/*.{md,yml,yaml}\" \"!data/**\" \"!node_modules/**\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"scripts/**/*.ts\" \"*.{json,mjs}\" \"!data/**\" \"!node_modules/**\"",
    "build": "tsc --noEmit && wrangler deploy --dry-run"
  },
  "dependencies": {
    "@thai-qr-payment/payload": "^1.2.0",
    "hono": "^4.6.0",
    "jose": "^5.9.0",
    "jpeg-js": "^0.4.4",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4",
    "upng-js": "^2.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260801.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.1",
    "@types/qrcode": "^1.5.6",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.66.0",
    "wrangler": "^4.0.0"
  }
}
