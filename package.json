{
  "name": "cc-cafe-reservation-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Workers backend for CCC Cafe Reservation (replaces Google Apps Script)",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:create": "wrangler d1 create cc-cafe-reservation-db",
    "db:migrate": "wrangler d1 migrations apply cc-cafe-reservation-db",
    "db:migrate:local": "wrangler d1 migrations apply cc-cafe-reservation-db --local",
    "db:seed": "node scripts/migrate.mjs",
    "kv:create": "wrangler kv namespace create CC_CACHE",
    "bucket:create": "wrangler r2 bucket create cc-cafe-reservation-slips"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.2",
    "@cloudflare/workers-types": "^5.20260801.1",
    "typescript": "^5.5.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.119.0"
  }
}
